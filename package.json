{
  "name": "sloth-note",
  "version": "0.1.0",
  "description": "Offline Markdown editor with notes in files the user controls",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "test": "node --test src/*.test.js",
    "preview": "vite preview",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "version:check": "node scripts/check-version.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "^1.48.0",
    "prismjs": "^1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@tauri-apps/cli": "2.11.5",
    "eslint": "9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}
