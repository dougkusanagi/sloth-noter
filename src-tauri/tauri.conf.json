{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sloth Note",
  "version": "../package.json",
  "identifier": "dev.slothnote.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sloth Note",
        "maximized": true,
        "width": 980,
        "height": 780,
        "minWidth": 360,
        "minHeight": 420,
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown",
        "description": "Markdown document",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["txt"],
        "name": "Text",
        "description": "Text document",
        "mimeType": "text/plain"
      }
    ],
    "shortDescription": "Offline Markdown editor",
    "longDescription": "Sloth Note keeps Markdown notes in files the user controls and works without network access.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxMjRFQ0U0RkZEQ0M4MjIKUldRaXlOei81T3drc2ZRSGpxTGM4MVdGalc4QU14d2ZUdHJzNDYzYm42blFYMWtNaGZ4ZkI0Y3YK",
      "endpoints": [
        "https://github.com/dougkusanagi/sloth-noter/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
